    <script>
        // --- بيانات التواصل الخاصة بك ---
        const phoneForWA = "966500000000"; // للواتساب (بدون أصفار أو +)
        const phoneForCall = "+966500000000"; // للاتصال المباشر (مع رمز الدولة)
        const myEmail = "mohamed@example.com"; // بريدك الإلكتروني

        // DOM elements
        const navbar = document.getElementById('navbar');
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const navLinks = document.getElementById('navLinks');
        
        // تحديث واجهة زر الإرسال بناءً على طريقة التواصل المختارة
        function updateButtonUI() {
            const method = document.getElementById('contact_method').value;
            const btn = document.getElementById('submit_btn');
            const btnIcon = btn.querySelector('i');
            
            if(method === 'whatsapp') {
                btn.style.background = "var(--whatsapp-green)";
                btn.innerHTML = '<i class="fab fa-whatsapp"></i> إرسال عبر واتساب';
            } else if(method === 'call') {
                btn.style.background = "var(--call-blue)";
                btn.innerHTML = '<i class="fas fa-phone-alt"></i> اتصال هاتفي مباشر';
            } else {
                btn.style.background = "var(--email-red)";
                btn.innerHTML = '<i class="fas fa-envelope"></i> إرسال عبر الإيميل';
            }
        }
        
        // معالجة نموذج الاتصال
        function processContact() {
            const name = document.getElementById('cust_name').value;
            const phone = document.getElementById('cust_phone').value;
            const service = document.getElementById('cust_service').value;
            const msg = document.getElementById('cust_msg').value;
            const method = document.getElementById('contact_method').value;

            if(!name || !phone) {
                alert("يرجى إدخال اسمك ورقم هاتفك أولاً");
                return;
            }
            
            // تحقق من صحة رقم الهاتف
            const phoneRegex = /^(05|5|9665|009665)([0-9]{8})$/;
            if (!phoneRegex.test(phone.replace(/\s/g, ''))) {
                alert("يرجى إدخال رقم هاتف سعودي صحيح (مثال: 05XXXXXXXX)");
                return;
            }

            const fullContent = `طلب صيانة من الموقع:\n──────────────\n👤 الأسم: ${name}\n📞 الهاتف: ${phone}\n🔧 الخدمة: ${service}\n📝 التفاصيل: ${msg}\n──────────────\n📅 تم الإرسال في: ${new Date().toLocaleString('ar-SA')}`;

            if(method === 'whatsapp') {
                window.open(`https://wa.me/${phoneForWA}?text=${encodeURIComponent(fullContent)}`, '_blank');
            } else if(method === 'call') {
                window.location.href = `tel:${phoneForCall}`;
            } else if(method === 'email') {
                window.location.href = `mailto:${myEmail}?subject=طلب صيانة من ${name}&body=${encodeURIComponent(fullContent)}`;
            }
        }
        
        // تغيير لون شريط التنقل عند التمرير
        window.addEventListener('scroll', function() {
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
            
            // تفعيل تأثيرات fade-in عند التمرير
            const fadeElements = document.querySelectorAll('.fade-in');
            
            fadeElements.forEach(element => {
                const elementTop = element.getBoundingClientRect().top;
                const elementVisible = 150;
                
                if (elementTop < window.innerHeight - elementVisible) {
                    element.classList.add('visible');
                }
            });
        });
        
        // تفعيل القائمة المتنقلة للجوّال
        mobileMenuBtn.addEventListener('click', function() {
            navLinks.classList.toggle('active');
            mobileMenuBtn.innerHTML = navLinks.classList.contains('active') 
                ? '<i class="fas fa-times"></i>' 
                : '<i class="fas fa-bars"></i>';
        });
        
        // إغلاق القائمة عند النقر على رابط
        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', () => {
                navLinks.classList.remove('active');
                mobileMenuBtn.innerHTML = '<i class="fas fa-bars"></i>';
            });
        });
        
        // تفعيل تأثيرات fade-in عند التحميل
        document.addEventListener('DOMContentLoaded', function() {
            // تفعيل العناصر المرئية عند التحميل
            const fadeElements = document.querySelectorAll('.fade-in');
            fadeElements.forEach((element, index) => {
                setTimeout(() => {
                    const elementTop = element.getBoundingClientRect().top;
                    const elementVisible = 150;
                    
                    if (elementTop < window.innerHeight - elementVisible) {
                        element.classList.add('visible');
                    }
                }, index * 100);
            });
            
            // تهيئة زر الإرسال
            updateButtonUI();
        });
        
        // إضافة تأثير كتابة للنص في قسم البطل
        const heroTitle = document.querySelector('.hero h1');
        const originalText = heroTitle.textContent;
        heroTitle.textContent = '';
        
        let i = 0;
        function typeWriter() {
            if (i < originalText.length) {
                heroTitle.textContent += originalText.charAt(i);
                i++;
                setTimeout(typeWriter, 100);
            }
        }
        
        // بدء تأثير الكتابة بعد تحميل الصفحة
        window.addEventListener('load', function() {
            setTimeout(typeWriter, 500);
        });
    </script>
